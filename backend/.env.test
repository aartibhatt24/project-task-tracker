# Running `npm test` requires a real reachable PostgreSQL database — replace the
# placeholder below (do NOT commit a real credential here; this file is tracked in git).
# Simplest option: point it at the same free Neon database you use for local dev (tests
# will wipe its data via resetDb() between test files — run `npm run seed` afterward to
# restore demo data). For a database that stays untouched, create a second free Neon
# project/branch just for tests instead.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
JWT_SECRET="test-secret-not-for-production"
PORT=4001
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="test"
