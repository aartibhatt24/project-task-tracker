# Copy this file to .env and adjust as needed.

# SQLite file path, via Prisma's sqlite provider. Resolved relative to
# backend/prisma/schema.prisma's directory (backend/prisma/), not the cwd.
DATABASE_URL="file:./dev.db"

# Secret used to sign auth JWTs. Must be a long random string in production.
JWT_SECRET="dev-only-change-me-please-a-long-random-string"

# Port the API server listens on.
PORT=4000

# Origin allowed to make credentialed requests (the frontend dev server).
CORS_ORIGIN="http://localhost:5173"

# "development" | "production" | "test"
NODE_ENV="development"

# Session cookie SameSite policy: "lax" | "strict" | "none".
# Keep "lax" when the frontend and this API share a registrable domain (including
# localhost:<any port>, which is why local dev works with the default). If you deploy the
# frontend and this API on DIFFERENT domains (e.g. a Vercel frontend + a Render API), set
# this to "none" — that automatically forces the cookie to `secure: true`, so both sides
# must be served over HTTPS or the browser will refuse the cookie.
COOKIE_SAME_SITE="lax"
